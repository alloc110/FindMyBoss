# FindMyBoss Environment Variables
# Copy this file to .env and fill in your API keys
# ---------------------------------------------------

# ── AI Provider API Keys ──────────────────────────
# Google Gemini (free tier at aistudio.google.com)
GEMINI_API_KEY=

# OpenAI / ChatGPT (platform.openai.com/api-keys)
OPENAI_API_KEY=

# Anthropic Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Custom/DeepSeek/Ollama (api.deepseek.com or localhost:11434)
CUSTOM_AI_API_KEY=
DEEPSEEK_API_KEY=

# ── Notifications (Optional) ──────────────────────
# Discord webhook for job scrape notifications
DISCORD_WEBHOOK_URL=

# ── Scraper Config (Optional) ─────────────────────
# Override default scraper delay (seconds)
# SCRAPER_DELAY_SECONDS=2.0

# ── Microservices Ports (Optional) ────────────────
# Host port mapping for scraper microservice (default: 8003)
# SCRAPER_PORT=8003